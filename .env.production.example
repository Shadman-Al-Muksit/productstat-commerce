# Copy to .env.production; replace EVERY placeholder before deployment.
PUBLIC_DOMAIN=shop.example.com
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=shop.example.com,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
PUBLIC_APP_URL=https://shop.example.com
POSTGRES_DB=productstat
POSTGRES_USER=productstat
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
PGDATABASE=productstat
PGUSER=productstat
PGPASSWORD=REPLACE_WITH_THE_SAME_DATABASE_PASSWORD
PRODUCTSTAT_DEMO=1
SSLCOMMERZ_SANDBOX=1
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Configure SMTP only for the company pilot; public demo uses no external mail.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
